Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
  # Single files opened alone in the editor do not see the rest of the unity
  # build. The real build still reports these.
  Suppress: [unused-function, undefined-internal]
CompileFlags:
  Add: [--include=base/base_inc.h, --include=window_manager/window_manager_inc.h]
---
If:
  PathMatch: .*\.c
CompileFlags:
  Add: [-xobjective-c]
